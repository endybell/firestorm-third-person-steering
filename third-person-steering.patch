+// <FS:TPS> Reuse the ordinary camera/agent rotation path without a fake click.
+bool LLToolCamera::canStartThirdPersonSteering() const
+{
+    return gViewerWindow && !gDisconnected && gAgent.isInitialized()
+        && isAgentAvatarValid() && !gAgentAvatarp->isSitting()
+        && gAgent.getTeleportState() == LLAgent::TELEPORT_NONE
+        && gAgentCamera.cameraThirdPerson()
+        && !LLViewerJoystick::getInstance()->getOverrideCamera()
+        && !LLFloaterCamera::inFreeCameraMode()
+        && !gSavedSettings.getBOOL("FreezeTime")
+        && gFocusMgr.getAppHasFocus()
+        && !gFocusMgr.focusLocked() && !gFocusMgr.getMouseCapture()
+        && LLToolMgr::getInstance()->getCurrentToolset() == gBasicToolset
+        && LLToolMgr::getInstance()->getBaseTool() == LLToolPie::getInstance()
+        && !LLToolMgr::getInstance()->usingTransientTool();
+}
+
+void LLToolCamera::toggleThirdPersonSteering()
+{
+    if (mThirdPersonSteering)
+    {
+        stopThirdPersonSteering();
+        return;
+    }
+    if (!canStartThirdPersonSteering())
+    {
+        return;
+    }
+
+    gFocusMgr.setKeyboardFocus(NULL);
+    LLToolTipMgr::instance().blockToolTips();
+    gAgentCamera.setFocusOnAvatar(true, false);
+
+    mMouseDownX = gViewerWindow->getCurrentMouseX();
+    mMouseDownY = gViewerWindow->getCurrentMouseY();
+    mMouseUpX = mMouseDownX;
+    mMouseUpY = mMouseDownY;
+    mMouseUpMask = MASK_NONE;
+    mAccumX = mAccumY = 0;
+    mOutsideSlopX = mOutsideSlopY = false;
+    mClickPickPending = false;
+    mValidClickPoint = true;
+    mMouseSteering = true; // Existing A/D handling now strafes, as when dragging the avatar.
+    mThirdPersonSteering = true;
+
+    LLToolMgr::getInstance()->setTransientTool(this);
+    setMouseCapture(true);
+    gViewerWindow->hideCursor();
+    gViewerWindow->moveCursorToCenter();
+    gViewerWindow->getWindow()->setMouseClipping(true);
+}
+
+void LLToolCamera::stopThirdPersonSteering()
+{
+    if (mThirdPersonSteering)
+    {
+        // handleMouseUp restores the original cursor position and releases capture.
+        // releaseMouse clears the latch before calling back into the tool manager.
+        handleMouseUp(mMouseDownX, mMouseDownY, MASK_NONE);
+    }
+}
